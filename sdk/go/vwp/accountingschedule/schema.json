{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavie.ai/schemas/accounting-schedule/v1",
  "title": "Executable accounting schedule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "kind", "currency", "amountScale", "startDate", "endDate", "totalAmount", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 240},
    "kind": {"enum": ["revenue_recognition", "depreciation", "fair_value_remeasurement", "impairment", "staking_rewards", "interest_accrual", "realized_gain_loss", "commission_accrual", "reconciling_adjustment", "token_issuance", "lease_cost", "fx_remeasurement", "error_correction", "contingency_accrual", "income_tax_provision", "mining_revenue", "safeguarding_liability"]},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "amountScale": {"type": "integer", "minimum": 0, "maximum": 8},
    "startDate": {"type": "string", "format": "date"},
    "endDate": {"type": "string", "format": "date"},
    "totalAmount": {"$ref": "#/$defs/amount"},
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "date", "description", "postings"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 120},
          "date": {"type": "string", "format": "date"},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "obligationId": {"type": "string"},
          "postings": {
            "type": "array", "minItems": 2, "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["accountRole"],
              "oneOf": [{"required": ["debit"]}, {"required": ["credit"]}],
              "properties": {
                "accountRole": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
                "debit": {"$ref": "#/$defs/amount"},
                "credit": {"$ref": "#/$defs/amount"},
                "dimensions": {
                  "type": "object", "maxProperties": 20,
                  "propertyNames": {"minLength": 1, "maxLength": 100},
                  "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 240}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,23})(\\.[0-9]{1,8})?$"}
  },
  "$comment": "Semantic validation additionally requires unique entry IDs, valid date range, positive amounts at amountScale, balanced entries, totalAmount equal to total debits, and ASC 606 allocation/obligation/monthly CSV tie-outs. No rounding or date inference occurs during creation."
}
