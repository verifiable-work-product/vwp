{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vwp.dev/schemas/v0.1/extensions/digital-assets-defi-positions/defi-position-valuation.schema.json",
  "title": "DeFi Position Valuation Calculation",
  "description": "The defiPositionValuation calculation: each position's fair value as the sum of its components (underlying assets, or the receipt token itself when that is the unit of account) at units x unit price as of the valuation date, each price supported by a fact stating that price on that date. The validators recompute every position and the total, check the price facts and their dates, and tie the positions and units to the defi-positions register.",
  "type": "object",
  "required": [
    "id",
    "type",
    "inputs",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "defiPositionValuation"
    },
    "inputs": {
      "type": "object",
      "required": [
        "asOf",
        "currency",
        "positions"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "components"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "components": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "asset",
                    "units",
                    "unitPrice",
                    "priceFact"
                  ],
                  "properties": {
                    "asset": {
                      "type": "string",
                      "minLength": 1
                    },
                    "units": {
                      "type": "number",
                      "minimum": 0
                    },
                    "unitPrice": {
                      "type": "number",
                      "minimum": 0
                    },
                    "priceFact": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Fact id whose value is {price, date} with price = unitPrice and date = asOf."
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": [
        "positions",
        "totalFairValue"
      ],
      "properties": {
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "fairValue"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "fairValue": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        },
        "totalFairValue": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "roundingTolerance": {
      "type": "number",
      "minimum": 0
    },
    "method": {
      "type": "string"
    },
    "validator": {
      "type": "string"
    },
    "recomputable": {
      "type": "boolean"
    }
  }
}
