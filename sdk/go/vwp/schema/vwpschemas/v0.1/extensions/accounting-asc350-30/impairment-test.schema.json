{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vwp.dev/schemas/v0.1/extensions/accounting-asc350-30/impairment-test.schema.json",
  "title": "ASC 350-30 Indefinite-Lived Intangible Impairment Test",
  "description": "Extension schema for the vwp-accounting-asc350-30 extension. Constrains a core calculation object of type 'indefiniteLivedIntangibleImpairmentTest': per lot, the carrying amount, the fair value used for the test (with the fact it comes from), and the resulting impairment loss and new carrying amount. Located by type under calculations/.",
  "type": "object",
  "required": [
    "id",
    "type",
    "inputs",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "indefiniteLivedIntangibleImpairmentTest"
    },
    "inputs": {
      "type": "object",
      "required": [
        "testDate",
        "lots"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "testDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The test date; one test per date and scope. A lot tested again later must start from the carrying amount the earlier test left."
        },
        "fairValueBasis": {
          "type": "string",
          "description": "How fair value for the test was observed, e.g. 'lowest observable intraday price in the principal market'."
        },
        "lots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "lotId",
              "asset",
              "carryingAmount",
              "fairValue",
              "fairValueFact"
            ],
            "properties": {
              "lotId": {
                "type": "string",
                "minLength": 1
              },
              "asset": {
                "type": "string",
                "minLength": 1
              },
              "units": {
                "type": "number",
                "minimum": 0
              },
              "carryingAmount": {
                "type": "number",
                "minimum": 0
              },
              "fairValue": {
                "type": "number",
                "minimum": 0
              },
              "fairValueFact": {
                "type": "string",
                "minLength": 1,
                "description": "Fact id for the fair value observation this lot was tested against."
              }
            },
            "additionalProperties": true
          }
        },
        "scope": {
          "type": "string",
          "description": "Optional scope label when more than one test (per collection or entity) is needed."
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": [
        "lots",
        "totalImpairmentLoss"
      ],
      "properties": {
        "lots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "lotId",
              "impairmentLoss",
              "carryingAmountAfter"
            ],
            "properties": {
              "lotId": {
                "type": "string",
                "minLength": 1
              },
              "impairmentLoss": {
                "type": "number"
              },
              "carryingAmountAfter": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "totalImpairmentLoss": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "roundingTolerance": {
      "type": "number",
      "minimum": 0
    },
    "method": {
      "type": "string"
    },
    "validator": {
      "type": "string"
    },
    "recomputable": {
      "type": "boolean"
    }
  }
}
