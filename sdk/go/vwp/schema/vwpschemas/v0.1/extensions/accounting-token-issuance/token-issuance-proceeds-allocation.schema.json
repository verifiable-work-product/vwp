{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vwp.dev/schemas/v0.1/extensions/accounting-token-issuance/token-issuance-proceeds-allocation.schema.json",
  "title": "Token Issuance Proceeds Allocation Calculation",
  "description": "The tokenIssuanceProceedsAllocation calculation: per instrument, the consideration received split into the balance-sheet components its classification produces (one component per classification; a hybrid instrument lists several). The validators recompute the per-instrument sums, the by-classification totals and the grand total, tie every instrument to the issuance-instruments register and its proceeds fact, and derive the executable token_issuance entries from it.",
  "type": "object",
  "required": [
    "id",
    "type",
    "inputs",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "tokenIssuanceProceedsAllocation"
    },
    "inputs": {
      "type": "object",
      "required": [
        "asOf",
        "currency",
        "instruments"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "instruments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "proceeds",
              "components"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "proceeds": {
                "type": "number",
                "minimum": 0
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "classification",
                    "amount"
                  ],
                  "properties": {
                    "classification": {
                      "type": "string",
                      "enum": [
                        "liability",
                        "equity",
                        "deferredRevenue",
                        "derivativeLiability"
                      ]
                    },
                    "amount": {
                      "type": "number",
                      "minimum": 0
                    },
                    "basis": {
                      "type": "string",
                      "description": "How the amount was measured (proceeds, fair value of the derivative at inception, residual)."
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": [
        "byClassification",
        "total"
      ],
      "properties": {
        "byClassification": {
          "type": "object",
          "required": [
            "liability",
            "equity",
            "deferredRevenue",
            "derivativeLiability"
          ],
          "properties": {
            "liability": {
              "type": "number",
              "minimum": 0
            },
            "equity": {
              "type": "number",
              "minimum": 0
            },
            "deferredRevenue": {
              "type": "number",
              "minimum": 0
            },
            "derivativeLiability": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "roundingTolerance": {
      "type": "number",
      "minimum": 0
    },
    "method": {
      "type": "string"
    },
    "validator": {
      "type": "string"
    },
    "recomputable": {
      "type": "boolean"
    }
  }
}
