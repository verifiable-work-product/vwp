{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vwp.dev/schemas/v0.1/extensions/accounting-asc842/lease-schedule.schema.json",
  "title": "ASC 842 Lease Schedule",
  "description": "Extension schema for the vwp-accounting-asc842 extension. Constrains a core calculation object of type 'leaseSchedule': one lease's initial measurement (present value of the lease payments at the discount rate, right-of-use asset) and its period-by-period liability roll-forward and lease cost. Located by type under calculations/; one calculation per lease.",
  "type": "object",
  "required": [
    "id",
    "type",
    "inputs",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "leaseSchedule"
    },
    "inputs": {
      "type": "object",
      "required": [
        "leaseId",
        "currency",
        "classification",
        "classificationJudgmentRef",
        "commencementDate",
        "discountRate",
        "rateFact",
        "paymentTiming",
        "payments"
      ],
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "classification": {
          "enum": [
            "operating",
            "finance"
          ]
        },
        "classificationJudgmentRef": {
          "type": "string",
          "minLength": 1,
          "description": "Id of the judgment that applies the ASC 842-10-25-2 criteria to this lease."
        },
        "commencementDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "discountRate": {
          "type": "number",
          "minimum": 0,
          "description": "Annual rate as a decimal (0.06 for 6%): the rate implicit in the lease when readily determinable, else the incremental borrowing rate (ASC 842-20-30-3)."
        },
        "rateFact": {
          "type": "string",
          "minLength": 1,
          "description": "Fact whose numeric value is discountRate (the rate's source)."
        },
        "paymentTiming": {
          "enum": [
            "arrears",
            "advance"
          ],
          "description": "arrears: each payment falls at the end of its period; advance: at the start."
        },
        "periodsPerYear": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            12
          ],
          "default": 12,
          "description": "Payment frequency; the per-period rate is discountRate / periodsPerYear."
        },
        "payments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "date",
              "amount"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        },
        "initialDirectCosts": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "leaseIncentives": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "prepaidLeasePayments": {
          "type": "number",
          "minimum": 0,
          "default": 0
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": [
        "initialLiability",
        "initialRouAsset",
        "periods"
      ],
      "properties": {
        "initialLiability": {
          "type": "number",
          "minimum": 0
        },
        "initialRouAsset": {
          "type": "number",
          "minimum": 0
        },
        "straightLineCost": {
          "type": "number",
          "minimum": 0,
          "description": "Operating leases: the single lease cost per period, (total payments + initial direct costs \u2212 incentives) / number of periods (ASC 842-20-25-6)."
        },
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "periodEnd",
              "openingLiability",
              "payment",
              "interest",
              "principal",
              "closingLiability",
              "leaseCost",
              "rouAmortization"
            ],
            "properties": {
              "periodEnd": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "openingLiability": {
                "type": "number",
                "minimum": 0
              },
              "payment": {
                "type": "number",
                "minimum": 0
              },
              "interest": {
                "type": "number",
                "minimum": 0
              },
              "principal": {
                "type": "number"
              },
              "closingLiability": {
                "type": "number",
                "minimum": 0
              },
              "leaseCost": {
                "type": "number",
                "minimum": 0
              },
              "rouAmortization": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "roundingTolerance": {
      "type": "number",
      "minimum": 0
    },
    "method": {
      "type": "string"
    },
    "validator": {
      "type": "string"
    },
    "recomputable": {
      "type": "boolean"
    }
  }
}
