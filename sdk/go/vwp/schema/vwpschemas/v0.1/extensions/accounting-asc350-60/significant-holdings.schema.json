{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vwp.dev/schemas/v0.1/extensions/accounting-asc350-60/significant-holdings.schema.json",
  "title": "ASC 350-60 Significant Holdings Table",
  "description": "Extension schema for the vwp-accounting-asc350-60 extension. Constrains a core calculation object of type 'significantCryptoHoldings' (the ASC 350-60-50-1 disclosure table): each holding's units, cost basis and fair value, which holdings are significant, and the split of fair value AND cost basis between significant and other (non-significant) holdings \u2014 50-1 requires the aggregate fair value and cost basis of non-significant holdings. Located by type under calculations/; several tables (per entity) may coexist when their scope differs.",
  "type": "object",
  "required": [
    "id",
    "type",
    "inputs",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "significantCryptoHoldings"
    },
    "inputs": {
      "type": "object",
      "required": [
        "asOf",
        "totalFairValue",
        "holdings"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Balance sheet date; must equal the periodEnd of the roll-forward with the same scope."
        },
        "totalFairValue": {
          "type": "number",
          "minimum": 0
        },
        "holdings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "asset",
              "units",
              "costBasis",
              "fairValue",
              "significant"
            ],
            "properties": {
              "asset": {
                "type": "string",
                "minLength": 1
              },
              "units": {
                "type": "number",
                "minimum": 0
              },
              "costBasis": {
                "type": "number",
                "minimum": 0
              },
              "fairValue": {
                "type": "number",
                "minimum": 0
              },
              "significant": {
                "type": "boolean"
              },
              "restricted": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "scope": {
          "type": "string",
          "description": "Optional scope label (entity, sub-group) when more than one table is needed."
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": [
        "significantFairValue",
        "otherFairValue",
        "significantCostBasis",
        "otherCostBasis"
      ],
      "properties": {
        "significantFairValue": {
          "type": "number",
          "minimum": 0
        },
        "otherFairValue": {
          "type": "number",
          "minimum": 0
        },
        "significantCostBasis": {
          "type": "number",
          "minimum": 0
        },
        "otherCostBasis": {
          "type": "number",
          "minimum": 0,
          "description": "Aggregate cost basis of non-significant holdings (ASC 350-60-50-1(b))."
        }
      },
      "additionalProperties": true
    },
    "roundingTolerance": {
      "type": "number",
      "minimum": 0
    },
    "method": {
      "type": "string"
    },
    "validator": {
      "type": "string"
    },
    "recomputable": {
      "type": "boolean"
    }
  }
}
