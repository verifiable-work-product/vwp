{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vwp.dev/schemas/v0.1/judgment.schema.json",
  "title": "VWP Judgment",
  "description": "A material professional judgment point: a question that required human professional judgment, its proposed conclusion, and its basis.",
  "type": "object",
  "required": ["id", "topic", "question"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "proposedConclusion": { "type": "string" },
    "basis": { "type": "string" },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conclusion": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "requiredApproverRole": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["open", "reviewRequired", "reviewed", "approved", "rejected"]
    }
  }
}
