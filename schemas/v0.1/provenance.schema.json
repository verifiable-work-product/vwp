{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vwp.dev/schemas/v0.1/provenance.schema.json",
  "title": "VWP Provenance",
  "description": "Records how the package was created: by whom, with which tools, models, policies, and source systems. Verification never requires the recorded models or tools.",
  "type": "object",
  "required": ["createdAt", "createdBy"],
  "properties": {
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["human", "agent", "system"]
        },
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "toolchain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "provider": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "policyVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "sourceSystems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": { "type": "string" }
  }
}
