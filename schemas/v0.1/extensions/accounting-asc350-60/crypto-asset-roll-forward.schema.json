{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vwp.dev/schemas/v0.1/extensions/accounting-asc350-60/crypto-asset-roll-forward.schema.json",
  "title": "ASC 350-60 Crypto Asset Roll-Forward",
  "description": "Extension schema for the vwp-accounting-asc350-60 extension. Constrains a core calculation object of type 'cryptoAssetRollForward' (the ASC 350-60-50-3 reconciliation): per asset, openingBalance + additions - dispositions + gains - losses = closingBalance, with column totals. Located by type under calculations/.",
  "type": "object",
  "required": [
    "id",
    "type",
    "inputs",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "cryptoAssetRollForward"
    },
    "inputs": {
      "type": "object",
      "required": [
        "periodStart",
        "periodEnd",
        "lines"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "periodStart": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "periodEnd": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Closing date; a holdings table with the same scope and asOf reconciles to this schedule. Consecutive periods of one scope must chain opening = prior closing."
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "asset",
              "openingBalance",
              "additions",
              "dispositions",
              "gains",
              "losses",
              "closingBalance"
            ],
            "properties": {
              "asset": {
                "type": "string",
                "minLength": 1
              },
              "openingBalance": {
                "type": "number"
              },
              "additions": {
                "type": "number",
                "minimum": 0
              },
              "dispositions": {
                "type": "number",
                "minimum": 0
              },
              "gains": {
                "type": "number",
                "minimum": 0
              },
              "losses": {
                "type": "number",
                "minimum": 0
              },
              "closingBalance": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "scope": {
          "type": "string",
          "description": "Optional scope label (entity, sub-group) when more than one roll-forward is needed."
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": [
        "totals"
      ],
      "properties": {
        "totals": {
          "type": "object",
          "required": [
            "openingBalance",
            "additions",
            "dispositions",
            "gains",
            "losses",
            "closingBalance"
          ],
          "properties": {
            "openingBalance": {
              "type": "number"
            },
            "additions": {
              "type": "number"
            },
            "dispositions": {
              "type": "number"
            },
            "gains": {
              "type": "number"
            },
            "losses": {
              "type": "number"
            },
            "closingBalance": {
              "type": "number"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "roundingTolerance": {
      "type": "number",
      "minimum": 0
    },
    "method": {
      "type": "string"
    },
    "validator": {
      "type": "string"
    },
    "recomputable": {
      "type": "boolean"
    }
  }
}
