{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vwp.dev/schemas/v0.1/extensions/accounting-asc830/foreign-currency-remeasurement.schema.json",
  "title": "ASC 830 Foreign Currency Remeasurement",
  "description": "Extension schema for the vwp-accounting-asc830 extension. Constrains a core calculation object of type 'foreignCurrencyRemeasurement': the remeasurement of foreign-currency-denominated monetary items into the functional currency at the period-end spot rate (ASC 830-20-35-1), with non-monetary items carried at their historical amounts. Located by type under calculations/; one calculation per functional currency and date.",
  "type": "object",
  "required": [
    "id",
    "type",
    "inputs",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "foreignCurrencyRemeasurement"
    },
    "inputs": {
      "type": "object",
      "required": [
        "functionalCurrency",
        "asOf",
        "items"
      ],
      "properties": {
        "functionalCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Equal to functionalCurrency; the currency the schedule books in."
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "scope": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "accountRole",
              "balanceSide",
              "currency",
              "foreignAmount",
              "monetary",
              "carryingAmount"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "accountRole": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "description": "The item's own ledger role (bound to an account when the schedule is created), e.g. cash_eur, trade_payables_gbp."
              },
              "balanceSide": {
                "enum": [
                  "debit",
                  "credit"
                ],
                "description": "The item's natural balance: debit for assets, credit for liabilities. Fixes the sign of the gain or loss."
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "The foreign currency the item is denominated in."
              },
              "foreignAmount": {
                "type": "number",
                "minimum": 0
              },
              "monetary": {
                "type": "boolean"
              },
              "carryingAmount": {
                "type": "number",
                "minimum": 0,
                "description": "Functional-currency carrying amount before remeasurement."
              },
              "spotRate": {
                "type": "number",
                "minimum": 0,
                "description": "Functional-currency units per one unit of the item's currency at asOf. Required for monetary items."
              },
              "rateFact": {
                "type": "string",
                "minLength": 1,
                "description": "Fact whose value is {rate, date} with rate = spotRate and date = asOf. Required for monetary items."
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": [
        "rows",
        "netGainLoss"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "remeasured",
              "gainLoss"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "remeasured": {
                "type": "number",
                "minimum": 0
              },
              "gainLoss": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "netGainLoss": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "roundingTolerance": {
      "type": "number",
      "minimum": 0
    },
    "method": {
      "type": "string"
    },
    "validator": {
      "type": "string"
    },
    "recomputable": {
      "type": "boolean"
    }
  }
}
