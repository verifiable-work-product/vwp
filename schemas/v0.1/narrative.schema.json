{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vwp.dev/schemas/v0.1/narrative.schema.json",
  "title": "VWP Narrative",
  "description": "The memo prose written against the package's memo format as the last step: every paragraph cites the objects it rests on, with the cited objects' closure hashes at the time of writing (spec/narrative.md, spec/integrity.md).",
  "type": "object",
  "required": [
    "formatHash",
    "analysisRoot",
    "sections"
  ],
  "properties": {
    "formatHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Self hash of the memo format snapshot (narrative/format.json) the narrative follows."
    },
    "analysisRoot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The package analysis root when the narrative was last written."
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "cite": {
      "type": "object",
      "required": [
        "id",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "paragraph": {
      "type": "object",
      "required": [
        "text",
        "role",
        "cites"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "role": {
          "type": "string",
          "enum": [
            "analysis",
            "conclusion",
            "literature"
          ]
        },
        "cites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cite"
          }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "paragraphs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "heading": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        },
        "subsections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "notApplicable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "One-line reason the section does not apply; such a section may have no paragraphs."
        }
      },
      "additionalProperties": false
    }
  }
}
